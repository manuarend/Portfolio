{
  "name": "jbp-digital-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "server": "nodemon server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "sync:month": "node scripts/sync_month_data.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "httpntlm": "^1.8.13",
    "lucide-react": "^0.469.0",
    "node-fetch": "^3.3.2",
    "puppeteer": "^25.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
